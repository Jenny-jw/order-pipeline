# Copy to .env and adjust. .env is gitignored; never put AWS keys in either file.
# AWS credentials come from ~/.aws/credentials via the profile named below.

S3_BUCKET=jenny-order-pipeline
S3_PREFIX=incoming/
AWS_PROFILE=order-pipeline
AWS_REGION=ap-northeast-1

DATABASE_URL=postgresql://orders_app:localdev@127.0.0.1:5432/orders
